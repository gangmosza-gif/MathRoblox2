Set-StrictMode -Version Latest
function Release-Com{param($o);if($null -ne $o -and [Runtime.InteropServices.Marshal]::IsComObject($o)){try{[void][Runtime.InteropServices.Marshal]::FinalReleaseComObject($o)}catch{}}}
function Open-AuditExcel{param([string]$Path);$x=New-Object -ComObject Excel.Application;$x.Visible=$false;$x.DisplayAlerts=$false;$x.EnableEvents=$false;$x.AskToUpdateLinks=$false;try{$x.AutomationSecurity=3}catch{};$b=$x.Workbooks.Open($Path,0,$true,5,'','',$true,2,'',$false,$false,0,$false,$true,0);[pscustomobject]@{Excel=$x;Book=$b}}
function Close-AuditExcel{param($s);if($s.Book){try{$s.Book.Close($false)}catch{}};if($s.Excel){try{$s.Excel.Quit()}catch{}};Release-Com $s.Book;Release-Com $s.Excel;[GC]::Collect();[GC]::WaitForPendingFinalizers()}
function Get-AuditWorkbookInspection{param([string]$Path);$fi=Get-Item $Path;$warnings=@();$hash=$null;try{$hash=(Get-FileHash $Path -Algorithm SHA256 -ErrorAction Stop).Hash}catch{$warnings+=$_.Exception.Message};$s=$null;try{$s=Open-AuditExcel $Path;$sheets=@();foreach($ws in @($s.Book.Worksheets)){$ur=$null;try{$ur=$ws.UsedRange;$sheets+=[pscustomobject]@{Name=[string]$ws.Name;UsedRange=[string]$ur.Address($false,$false);Rows=[int]$ur.Rows.Count;Columns=[int]$ur.Columns.Count}}finally{Release-Com $ur;Release-Com $ws}};[pscustomobject]@{FileName=$fi.Name;FullPath=$Path;SHA256=$hash;Warnings=$warnings;InspectionStatus=$(if($warnings.Count){'WARNING'}else{'READY'});Summary=[pscustomobject]@{SheetCount=@($sheets).Count};Sheets=$sheets}}finally{if($s){Close-AuditExcel $s}}}
function Invoke-AuditMappingScan{param([string]$Path,$Mapping);if($Mapping.status -notin @('draft_observed','user_confirmed')){return[pscustomobject]@{ItemId=$Mapping.item_id;Status='PENDING';Value='';Message='Mapping ยังไม่พร้อม'}};$s=$null;$ws=$null;$cell=$null;try{$s=Open-AuditExcel $Path;$ws=$s.Book.Worksheets.Item([string]$Mapping.sheet.name);$a=[string]$Mapping.read_rule.source_cell;$cell=$ws.Range($a);$v=[string]$cell.Text;if([string]::IsNullOrWhiteSpace($v)){$v=[string]$cell.Value2};[pscustomobject]@{ItemId=$Mapping.item_id;Status=$(if($Mapping.status -eq 'user_confirmed'){'READY'}else{'DRAFT'});Value=$v.Trim();Message="อ่านจาก $($Mapping.sheet.name)!$a"}}catch{[pscustomobject]@{ItemId=$Mapping.item_id;Status='BLOCKED';Value='';Message=$_.Exception.Message}}finally{Release-Com $cell;Release-Com $ws;if($s){Close-AuditExcel $s}}}
Export-ModuleMember -Function Get-AuditWorkbookInspection,Invoke-AuditMappingScan
